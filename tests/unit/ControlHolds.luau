--!strict
const Holds = require("../../src/ControlHolds")
const Spec = require("../Spec")
const function noop() end
const function wants(book: Holds.Book, touch: boolean, pad: boolean): { boolean }
	const movement, gui = Holds.wants(book, touch, pad)
	return { movement, gui }
end
Spec.test("controls zero ownership writes nothing", function()
	const book = Holds.new()
	Spec.equal(Holds.active(book), false)
	for _, input in { { false, false }, { true, false }, { false, true } } do
		Spec.equal(wants(book, input[1], input[2]), { false, false })
	end
end)
Spec.test("controls same reason independent leases double release", function()
	const book = Holds.new()
	local calls = 0
	const function changed()
		calls += 1
	end
	const a = Holds.hold(book, "same", changed)
	const b = Holds.hold(book, "same", changed)
	a()
	a()
	Spec.equal(calls, 3)
	Spec.equal(Holds.active(book), true)
	b()
	b()
	Spec.equal(calls, 4)
	Spec.equal(Holds.active(book), false)
	const c = Holds.hold(book, "same", noop)
	const d = Holds.hold(book, "same", noop)
	d()
	Spec.equal(Holds.active(book), true)
	c()
	Spec.equal(Holds.active(book), false)
end)
Spec.test("controls reverse different reason release", function()
	const book = Holds.new()
	const a = Holds.hold(book, "a", noop)
	const b = Holds.hold(book, "b", noop)
	b()
	Spec.equal(Holds.active(book), true)
	a()
	Spec.equal(Holds.active(book), false)
end)
Spec.test("controls bits idempotent and independent of same reason lease", function()
	const book = Holds.new()
	Holds.set(book, "same", true)
	Holds.set(book, "same", true)
	const release = Holds.hold(book, "same", noop)
	Holds.set(book, "same", false)
	Holds.set(book, "same", false)
	Spec.equal(Holds.active(book), true)
	Holds.set(book, "same", true)
	release()
	Spec.equal(Holds.active(book), true)
	Holds.set(book, "same", false)
	Spec.equal(Holds.active(book), false)
end)
Spec.test("controls leases all inputs bits touch pad only", function()
	const book = Holds.new()
	Holds.set(book, "panel", true)
	Spec.equal(wants(book, false, false), { false, false })
	Spec.equal(wants(book, true, false), { true, true })
	Spec.equal(wants(book, false, true), { true, false })
	const release = Holds.hold(book, "camera", noop)
	Spec.equal(wants(book, false, false), { true, false })
	Spec.equal(wants(book, true, true), { true, true })
	release()
	Spec.equal(wants(book, false, false), { false, false })
end)
return {}
